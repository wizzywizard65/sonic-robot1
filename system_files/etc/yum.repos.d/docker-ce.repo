[docker-ce-stable]
name=Docker CE Stable - $basearch
baseurl=https://download.docker.com/linux/fedora/$releasever/x86_64/stable/Packages/
enabled=1
gpgcheck=1
gpgkey=https://download.docker.com/linux/fedora/gpg

